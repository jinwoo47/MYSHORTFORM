<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MyShortform</title>
<style>
:root{--bg:linear-gradient(135deg,#c7d2fe 0%,#fbcfe8 50%,#fde68a 100%);--card:rgba(255,255,255,.42);--tx:#1e1b2e;--mu:#554f6b;--ac:#6d28d9;--on:#fff;--bd:rgba(255,255,255,.65);--ok:#15803d;--bad:#b91c1c;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:linear-gradient(135deg,#1e1b4b 0%,#4c1d95 55%,#831843 100%);--card:rgba(255,255,255,.09);--tx:#f5f3ff;--mu:#c1badb;--ac:#a78bfa;--on:#1e1b4b;--bd:rgba(255,255,255,.18);--ok:#4ade80;--bad:#f87171;color-scheme:dark}}
:root[data-theme="dark"]{--bg:linear-gradient(135deg,#1e1b4b 0%,#4c1d95 55%,#831843 100%);--card:rgba(255,255,255,.09);--tx:#f5f3ff;--mu:#c1badb;--ac:#a78bfa;--on:#1e1b4b;--bd:rgba(255,255,255,.18);--ok:#4ade80;--bad:#f87171;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg) fixed;color:var(--tx);font:16px/1.6 Georgia,"Times New Roman",serif}
#app{max-width:720px;margin:0 auto;padding:18px 16px 48px}
h1{font:700 26px/1.2 system-ui,sans-serif;margin:4px 0 2px}
h2{font:700 19px/1.3 system-ui,sans-serif;margin:22px 0 8px}
.sub{color:var(--mu);margin:0 0 16px;font-family:system-ui,sans-serif;font-size:14px}
input,textarea,button{font:inherit;font-family:system-ui,sans-serif}
input,textarea{width:100%;box-sizing:border-box;padding:12px;border:1px solid var(--bd);border-radius:16px;background:var(--card);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);color:var(--tx);margin-bottom:10px}input::placeholder,textarea::placeholder{color:var(--mu)}
textarea{min-height:200px;resize:vertical;line-height:1.5}
button{border:0;border-radius:999px;padding:11px 18px;background:var(--ac);color:var(--on);font-weight:600;cursor:pointer;box-shadow:0 4px 16px rgba(109,40,217,.3)}
button.g{background:var(--card);color:var(--tx);border:1px solid var(--bd);box-shadow:none;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
button:disabled{opacity:.5}
.card{background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:16px;margin:12px 0;backdrop-filter:blur(18px) saturate(160%);-webkit-backdrop-filter:blur(18px) saturate(160%);box-shadow:0 8px 32px rgba(31,38,135,.2)}
.row{display:flex;gap:8px;align-items:center;justify-content:space-between}
.tabs{display:flex;gap:6px;overflow-x:auto;margin:14px 0}
.tabs button{background:var(--card);color:var(--tx);border:1px solid var(--bd);white-space:nowrap;box-shadow:none;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.tabs button.on{background:var(--ac);color:var(--on);border-color:var(--ac)}
.big{font-size:18px;font-style:italic}
details summary{cursor:pointer;font:600 16px system-ui,sans-serif}
details p,details ul{margin:8px 0 2px}
.opt{display:block;width:100%;text-align:left;background:var(--card);color:var(--tx);border:1px solid var(--bd);border-radius:16px;margin:8px 0;font-weight:400;box-shadow:none}
.opt.ok{border-color:var(--ok);color:var(--ok)}.opt.no{border-color:var(--bad);color:var(--bad)}
.why{font-size:14px;color:var(--mu);margin:6px 0 0;font-family:system-ui,sans-serif}
.st{color:var(--mu);font-family:system-ui,sans-serif;font-size:14px;min-height:20px}
.p{white-space:pre-wrap}
</style></head>
<body><div id="app"></div>
<script>
const esc=s=>String(s==null?"":s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
let lib=[],cur=null,tab="sum",busy=false,delArm=null,msg="",mode="book";
try{lib=JSON.parse(localStorage.getItem("msf")||"[]")}catch(e){}
const persist=()=>{try{localStorage.setItem("msf",JSON.stringify(lib))}catch(e){}};
const saved=()=>cur&&lib.some(x=>x.id===cur.id);
let key="";try{key=localStorage.getItem("msf_key")||""}catch(e){}
const A=document.getElementById("app");
async function ai(p){
 const r=await fetch("https://api.anthropic.com/v1/messages",{method:"POST",headers:{"content-type":"application/json","x-api-key":key,"anthropic-version":"2023-06-01","anthropic-dangerous-direct-browser-access":"true"},body:JSON.stringify({model:"claude-sonnet-5-5",max_tokens:6000,messages:[{role:"user",content:p}]})});
 if(r.status===401)throw new Error("API key rejected. Check it and save again.");
 if(r.status===429)throw new Error("Rate limit hit. Wait a minute and retry.");
 if(!r.ok)throw new Error("API error "+r.status+".");
 const d=await r.json();const t=(d.content||[]).map(x=>x.text||"").join("");
 const i=t.indexOf("{"),j=t.lastIndexOf("}");
 if(i<0||j<i)throw new Error("Couldn’t read the result. Try again.");
 return JSON.parse(t.slice(i,j+1));
}

function prompt_(t,a){
return `You write original book summaries and study guides. Book: "${t}"${a?" by "+a:""}. If you do not reliably know this book, return {"error":"I don’t know this book well enough. Check the title or add the author."}. Otherwise return ONLY JSON: {"title":str,"author":str,"oneLiner":str,"bigIdea":str (2-3 sentences),"summary":str (4 short paragraphs separated by \\n\\n),"chapters":[{"title":str,"summary":str (2-4 sentences),"takeaways":[str,str]}] (one per chapter or major part, max 12),"qui